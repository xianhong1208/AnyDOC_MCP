# =============================================================================
# AnyDoc environment variables - copy to .env and adjust (.env is git-ignored)
#
# config/config.yaml reads these through ${VAR:-default}; every variable below
# has a default, so a bare `uv run python main.py` works for local development.
# =============================================================================

# --- Server -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5055
LOG_LEVEL=INFO

# --- Authentication (MCP Gate) ------------------------------------------------
# The MCP Gate instance that issues tokens for this server (its OAUTH_ISSUER).
MCP_GATE_URL=http://localhost:4568
# The address this server is reached at. Register the same host and port in MCP Gate;
# the token audience is derived from it as <ANYDOC_BASE_URL>/mcp and must match exactly.
ANYDOC_BASE_URL=http://127.0.0.1:5055
# Set to false only for local experiments without MCP Gate.
AUTH_ENABLED=true
# MCP Gate revocation feed (README -> "Token revocation"): revoked tokens stop working
# within one poll interval instead of at expiry. Needs a confidential client registered in
# MCP Gate and bound to AnyDoc as its resource server.
ANYDOC_REVOCATION_ENABLED=false
ANYDOC_REVOCATION_CLIENT_ID=
ANYDOC_REVOCATION_CLIENT_SECRET=
ANYDOC_REVOCATION_POLL_INTERVAL=30
# open = keep accepting tokens while MCP Gate is unreachable; closed = reject them all once stale
ANYDOC_REVOCATION_FAIL_MODE=open

# --- Conversion ---------------------------------------------------------------
MAX_INPUT_MB=50
ENGINE_TIMEOUT=180
