# =============================================================================
# AnyDoc environment variables - copy to .env and adjust (.env is git-ignored)
#
# config/config.yaml reads these through ${VAR:-default}; every variable below
# has a default, so a bare `uv run python main.py` works for local development.
# =============================================================================

# --- Server -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5055
LOG_LEVEL=INFO

# --- Authentication (MCP Center) ----------------------------------------------
# The MCP Center instance that issues tokens for this server (its OAUTH_ISSUER).
MCP_CENTER_URL=http://localhost:4568
# The address this server is reached at. Register the same host and port in MCP Center;
# the token audience is derived from it as <ANYDOC_BASE_URL>/mcp and must match exactly.
ANYDOC_BASE_URL=http://127.0.0.1:5055
# Set to false only for local experiments without MCP Center.
AUTH_ENABLED=true

# --- Conversion ---------------------------------------------------------------
MAX_INPUT_MB=50
ENGINE_TIMEOUT=180
